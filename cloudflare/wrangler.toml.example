name = "oao-ai"
main = "oao-ai-worker.js"
compatibility_date = "2024-01-01"

# 复制为 wrangler.toml 后填写 account_id，并执行: npx wrangler deploy
# 智谱 Key 勿写入此文件，请用: npx wrangler secret put ZHIPU_API_KEY

# account_id = "你的 Cloudflare Account ID"

[[d1_databases]]
binding = "DB"
database_name = "oao-platform"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"

[durable_objects]
bindings = [
  { name = "MEETING_ROOM", class_name = "MeetingRoom" }
]

[[migrations]]
tag = "v1"
new_classes = ["MeetingRoom"]

[vars]
ZHIPU_MODEL = "glm-4.7-flash"
# 可选 — 限流阈值（也可设为 Secret）
# OAO_RATE_WALLET_PER_MIN = "10"
# OAO_RATE_ANON_PER_MIN = "3"
# OAO_GLM_DAILY_ALERT = "500"
# LLM_ORIGIN = "https://llm.你的域名.com"
# OLLAMA_ORIGIN = "https://ollama.你的域名.com"
# ANYTHINGLLM_API_KEY = "（可选，仅 Tunnel 代理 AnythingLLM 时使用）"
